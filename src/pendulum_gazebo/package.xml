<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pendulum_gazebo</name>
  <version>0.1.0</version>
  <description>
    Reusable Gazebo Sim bringup for the LDR pendulum testbed: resource-path
    setup, custom world, robot spawn, and the gz-&gt;ROS /clock bridge.
    Included by the pendulum_pd_control sim launches.
  </description>
  <maintainer email="andrei.dragomir@ldrobots.ro">Andrei Dragomir</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>pendulum_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
