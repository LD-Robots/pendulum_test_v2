<?xml version="1.0"?>
<robot name="pendulum">

  <link name="base_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <link name="motor_body">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
      <material name="steel_blue">
        <color rgba="0.3 0.4 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="motor_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_body"/>
    <origin xyz="0 0.06 1.2" rpy="0 0 0"/>
  </joint>

  <link name="pendulum_link">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.1"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00008667" ixy="0" ixz="0"
               iyy="0.00008667" iyz="0"
               izz="0.00000667"/>
    </inertial>
  </link>

  <link name="motor_shaft">
    <visual>
      <origin xyz="0 -0.03 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.06"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="shaft_joint" type="fixed">
    <parent link="pendulum_link"/>
    <child link="motor_shaft"/>
    <origin xyz="0 0.01 0" rpy="0 0 0"/>
  </joint>

  <joint name="pendulum_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pendulum_link"/>
    <origin xyz="0 0 1.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="6.28318530718" effort="20.0" velocity="16.02"/>
    <dynamics damping="0.16" friction="1.6"/>
  </joint>

</robot>
