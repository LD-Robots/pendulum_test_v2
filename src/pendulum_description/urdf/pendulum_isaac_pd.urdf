<?xml version="1.0"?>
<!--
  Pendulum URDF for SWING-UP task (Isaac Lab guide protocol).

  Physics: onshape-to-robot export from pendulum_test_v1/pendulum_test.urdf —
  the REAL physical build.

    urdf_masa       — 16.32 kg table + menghina + X6 motor housing (fixed base)
    urdf_spacer     — 0.277 kg rotor assembly
    urdf_profile_700 — 0.525 kg 700mm profile + weight mount
    urdf_weight     — 1.037 kg weight + stopper

  Total rotating mass = 0.277 + 0.525 + 1.037 = 1.839 kg

  Key differences vs onshape export:
    - rotor_roll_joint → pendulum_joint (plugins/controllers expect this name)
    - type="continuous" (no position limits — swing-up needs free rotation)
    - Added base_link + fixed joint so Isaac can treat urdf_masa as articulation root
    - Damping from measured X6 (0.065), friction handled in DCMotor actuator cfg
-->
<robot name="pendulum">

  <link name="base_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- Fixed base: table + menghina + motor housing -->
  <link name="urdf_masa">
    <inertial>
      <origin xyz="1.101e-09 -0.00216375 0.0537769" rpy="0 0 0"/>
      <mass value="16.32"/>
      <inertia ixx="0.925693" ixy="4.516e-09" ixz="1.9989e-08"
               iyy="1.0281"   iyz="0.0467944"
               izz="0.966281"/>
    </inertial>
    <visual>
      <origin xyz="-1.1089e-08 -0.223416 0.181468" rpy="-1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_menghina.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-1.1089e-08 -0.223416 0.181468" rpy="-1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_menghina.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0 0.0156153 0.041001" rpy="-1.5708 -0 3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_masa.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0 0.0156153 0.041001" rpy="-1.5708 -0 3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_masa.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0 -0.191779 0.209622" rpy="-1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_x6.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0 -0.191779 0.209622" rpy="-1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_x6.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="masa_to_base" type="fixed">
    <parent link="base_link"/>
    <child link="urdf_masa"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Rotor (rotates with motor) -->
  <link name="urdf_spacer">
    <inertial>
      <origin xyz="-9.40034e-07 3.43567e-06 -0.0451209" rpy="0 0 0"/>
      <mass value="0.277"/>
      <inertia ixx="0.000204906" ixy="3.75e-10" ixz="1.0966e-08"
               iyy="0.000188403" iyz="5.527e-09"
               izz="0.000195731"/>
    </inertial>
    <visual>
      <origin xyz="-0 0 -0.0387375" rpy="-3.14159 -0 -3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_rotor_base.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0 0 -0.0387375" rpy="-3.14159 -0 -3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_rotor_base.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-1.03149e-05 -0 -0.012" rpy="-3.14159 -0 1.5708"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_spacer.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-1.03149e-05 -0 -0.012" rpy="-3.14159 -0 1.5708"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_spacer.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="1.33413e-07 -1.26979e-06 -0.065381" rpy="-3.14159 -0 -3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_rotor_lid.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="1.33413e-07 -1.26979e-06 -0.065381" rpy="-3.14159 -0 -3.14159"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_rotor_lid.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Motor joint: CONTINUOUS (no limits) for swing-up.
       Original rotor_roll_joint had limits [-π, π]; removed here because
       the pendulum must be free to rotate past upright in either direction. -->
  <joint name="pendulum_joint" type="continuous">
    <origin xyz="-0 -0.227029 0.209622" rpy="-1.5708 1.5708 0"/>
    <parent link="urdf_masa"/>
    <child link="urdf_spacer"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.065" friction="0.0"/>
  </joint>

  <!-- 700mm profile + weight mount (fixed to rotor) -->
  <link name="urdf_profile_700">
    <inertial>
      <origin xyz="-0.00432073 -4.9393e-08 -0.445007" rpy="0 0 0"/>
      <mass value="0.525"/>
      <inertia ixx="0.0286674" ixy="1.26e-10" ixz="-0.000466791"
               iyy="0.0287381" iyz="-6.06e-09"
               izz="0.000160326"/>
    </inertial>
    <visual>
      <origin xyz="0 -0 -0.35" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_profile_700.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0 -0.35" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_profile_700.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-1.6356e-08 -0 0.0033423" rpy="-0 1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_cap.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-1.6356e-08 -0 0.0033423" rpy="-0 1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_cap.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0.0108614 -5.77328e-07 -0.650001" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight_base.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0108614 -5.77328e-07 -0.650001" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight_base.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.00949929 -1.15e-10 -0.650649" rpy="-0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight_lid.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.00949929 -1.15e-10 -0.650649" rpy="-0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight_lid.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="1.6356e-08 -0 -0.703342" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_cap2.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="1.6356e-08 -0 -0.703342" rpy="0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_cap2.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.0372188 2e-12 -0.650649" rpy="-0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight_shaft.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0372188 2e-12 -0.650649" rpy="-0 -1.5708 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight_shaft.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="Profile" type="fixed">
    <origin xyz="-0.35 -0 -0.0541" rpy="0 -1.5708 0"/>
    <parent link="urdf_spacer"/>
    <child link="urdf_profile_700"/>
  </joint>

  <!-- Weight (stopper + mass) -->
  <link name="urdf_weight">
    <inertial>
      <origin xyz="-2.56e-10 8.82e-10 0.00721586" rpy="0 0 0"/>
      <mass value="1.037"/>
      <inertia ixx="0.000384095" ixy="-2.829e-09" ixz="2e-12"
               iyy="0.000384111" iyz="-1.4e-11"
               izz="0.000710724"/>
    </inertial>
    <visual>
      <origin xyz="-2.991e-09 1.2324e-08 0.0304031" rpy="-0 0 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight_stopper.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-2.991e-09 1.2324e-08 0.0304031" rpy="-0 0 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight_stopper.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 -0 0.0055" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0 0.0055" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://pendulum_description/meshes/urdf_weight.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="Weight" type="fixed">
    <origin xyz="-0.0182 -0 -0.65" rpy="3.14159 1.5708 0"/>
    <parent link="urdf_profile_700"/>
    <child link="urdf_weight"/>
  </joint>

</robot>
